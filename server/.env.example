# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scrumflow?retryWrites=true&w=majority
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed front-end origins (your Netlify URL in production)
CLIENT_URL=http://localhost:5173
PORT=5000
