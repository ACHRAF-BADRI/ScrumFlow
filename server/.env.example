# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scrumflow?retryWrites=true&w=majority
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed front-end origins (your Cloudflare Pages URL in production, first = where users are sent back)
CLIENT_URL=http://localhost:5173
PORT=5000
# Resend (transactional emails): https://resend.com/api-keys (a "Sending access" key is enough)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Sender. Until a domain is verified in Resend, only onboarding@resend.dev works (and only to your own email)
EMAIL_FROM=ScrumFlow <onboarding@resend.dev>

# ---- Optional features (hidden in the app when empty) ----
# Public URL of this API, for sign in redirects and webhook URLs (Render sets RENDER_EXTERNAL_URL itself)
API_URL=http://localhost:5000
# Attachments: Cloudinary dashboard > API environment variable
CLOUDINARY_URL=
# Sign in with Google: redirect URI = <API_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with GitHub: callback URL = <API_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Microsoft: redirect URI = <API_URL>/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Sign in with GitLab: redirect URI = <API_URL>/api/auth/oauth/gitlab/callback, scope read_user
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Only for a self-hosted GitLab (default https://gitlab.com)
GITLAB_URL=
# Sign in with Bitbucket: OAuth client (workspace settings) with callback URL <API_URL>/api/auth/oauth/bitbucket/callback,
# permissions Account: Email + Read
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
# AI suggestions: groq (free tier, console.groq.com), gemini (free tier, aistudio.google.com), openrouter or anthropic
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: another model of the provider, and the daily limit of AI uses per project (default 30)
AI_MODEL=
AI_DAILY_LIMIT=30
